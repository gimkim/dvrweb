<?xml version="1.0" encoding="utf-8"?>
<configuration><location path="." inheritInChildApplications="false"><system.webServer>
 <handlers><add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" /></handlers>
 <aspNetCore processPath="dotnet" arguments=".\MotionService.dll" stdoutLogEnabled="false" hostingModel="OutOfProcess" requestTimeout="00:03:00" />
 <security><requestFiltering><requestLimits maxAllowedContentLength="268435456" /></requestFiltering></security>
</system.webServer></location></configuration>
